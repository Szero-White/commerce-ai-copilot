# Default: works with no paid API, retrieval-only (NO generated answers)
LLM_PROVIDER=off
EMBEDDING_PROVIDER=off
# Optional: requires Ollama plus manually downloaded local models
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5:1.5b
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=bge-m3
OLLAMA_URL=http://127.0.0.1:11434
# Explicit context window sent to Ollama (tokens). Prompt + answer must fit inside it.
OLLAMA_NUM_CTX=4096
MAX_CONTEXT_CHARS=2600
MAX_OUTPUT_TOKENS=256
LLM_TIMEOUT_SECONDS=45
# Hosted free-tier alternative (NOT run by the author). Put the key in the environment, never in a file:
# LLM_PROVIDER=gemini
# EMBEDDING_PROVIDER=gemini
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_MAX_REQUESTS=150
# GEMINI_EMBED_TEXTS_PER_MINUTE=60   # embeddings are metered per TEXT (clamped to 1..90)
# GEMINI_MAX_EMBED_TEXTS=200
# GEMINI_EMBED_CACHE=on                # on-disk cache: runtime/embedding_cache.db
# DATA_PATH=runtime/lab.db
